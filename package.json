{
  "name": "erepublik-agent",
  "version": "0.1.7",
  "private": true,
  "main": "electron-dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "tsx src/bootstrap.ts",
    "healthcheck": "tsx src/healthcheck.ts",
    "missions": "tsx src/showMissions.ts",
    "farmable": "tsx src/showFarmableBattles.ts",
    "farm-one": "tsx src/farmOne.ts",
    "farmer": "tsx src/farmRunner.ts",
    "debug-deploy": "tsx src/debugDeploy.ts",
    "debug-headers": "tsx src/debugHeaders.ts",
    "start": "tsx src/agent/runner.ts",
    "agent": "tsx src/agent/runner.ts -- --once",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/ui/public','dist/ui/public',{recursive:true})\"",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').cpSync('electron/wizard','electron-dist/wizard',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\" && node -e \"require('fs').cpSync('electron/icons','electron-dist/icons',{recursive:true})\" && node -e \"require('fs').cpSync('data/countries.json','electron-dist/wizard/countries.json')\"",
    "start:electron": "npm run build && npm run build:electron && electron electron-dist/main.js",
    "dist:electron": "npm run build && npm run build:electron && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cloakbrowser": "^0.3.28",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "playwright-core": "^1.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
