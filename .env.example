ERP_LOGIN=your@email.com
ERP_PASSWORD=yourpassword
ERP_ACCOUNT_SLUG=main
# Optional fallback for country ID — by default it is auto-detected from the
# browser context (erepublik.citizen.citizenshipCountryId). Only set this if
# auto-detection fails for some reason.
# ERP_COUNTRY_ID=40

# Refuse to buy if Q1 food's priceWithTaxes exceeds this ceiling (in local currency).
# Sane Q1 food prices are typically 0.5–2.0 — set with a safety margin.
ERP_MAX_FOOD_PRICE=3.0
HEADED=false

LOOP_INTERVAL_MS=600000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Captcha handling (eRepublik session-unlock challenge).
# - none     → detect + Telegram alert + bail the cycle (default; no cost)
# - 2captcha → auto-solve via api.2captcha.com (CoordinatesTask, ~$0.001/solve)
ERP_CAPTCHA_PROVIDER=none
# Required when ERP_CAPTCHA_PROVIDER != none. Get from 2captcha.com dashboard.
ERP_CAPTCHA_API_KEY=
# How many solve attempts before giving up (refreshes the challenge between tries).
ERP_CAPTCHA_MAX_ATTEMPTS=3
