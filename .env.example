ERP_LOGIN=your@email.com
ERP_PASSWORD=yourpassword
ERP_ACCOUNT_SLUG=main
# Optional fallback for country ID — by default it is auto-detected from the
# browser context (erepublik.citizen.citizenshipCountryId). Only set this if
# auto-detection fails for some reason.
# ERP_COUNTRY_ID=40

# Refuse to buy if Q1 food's priceWithTaxes exceeds this ceiling (in local currency).
# Sane Q1 food prices are typically 0.5–2.0 — set with a safety margin.
ERP_MAX_FOOD_PRICE=3.0
HEADED=false

LOOP_INTERVAL_MS=600000

# UI dashboard binding. Defaults to 0.0.0.0 (reachable from LAN) so you can
# open it from another machine. Set to 127.0.0.1 to restrict to loopback only
# (e.g. when relying on an SSH tunnel and not wanting LAN exposure).
# The UI has no authentication — keep it off the public internet.
ERP_UI_HOST=0.0.0.0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Captcha handling (eRepublik session-unlock challenge).
# - none     → detect + Telegram alert + bail the cycle (default; no cost)
# - 2captcha → auto-solve via api.2captcha.com (CoordinatesTask, ~$0.001/solve)
ERP_CAPTCHA_PROVIDER=none
# Required when ERP_CAPTCHA_PROVIDER != none. Get from 2captcha.com dashboard.
ERP_CAPTCHA_API_KEY=
# How many solve attempts before giving up (refreshes the challenge between tries).
ERP_CAPTCHA_MAX_ATTEMPTS=10

# Auto return-home. After spending this many minutes outside the residence region,
# the agent travels back home on the next idle cycle (i.e. a cycle that doesn't
# trigger a farm session, so the round-trip is not wasted). 0 disables the feature.
ERP_RETURN_HOME_AFTER_MINUTES=15
# Hard ceiling on the residence-trip travel cost in local CC. The agent
# pre-checks via /main/travelData and skips + alerts when the cost exceeds
# this budget — travel home is NOT free.
ERP_RETURN_HOME_MAX_CC=500

# Cooldown range (minutes) between farm sessions. After each session ends, the
# bot rolls a random wait time in [MIN, MAX] before becoming eligible again.
# These env vars seed config/settings.json on first run only — after that, edit
# settings.farmSession.cooldownMinMinutes / cooldownMaxMinutes via the UI or
# the JSON file directly.
ERP_SESSION_COOLDOWN_MIN_MIN=5
ERP_SESSION_COOLDOWN_MAX_MIN=15

# Hard cap on empty-division battles per farm cycle (Standard + Maverick-D3
# strategies). Energy / fuel / weekly-pace limits may bring the effective
# number lower. Seeds settings.emptyDiv.maxBattlesPerSession on first run —
# afterwards edit via the UI or settings.json directly. Default 3, range 1-10.
ERP_EMPTY_DIV_MAX_BATTLES_PER_SESSION=3
# Hard cap on D4-TW battles per farm cycle. Default 1 (a full TW deploy is
# 1500-3000 energy — usually only one fits per pool). Seeds
# settings.d4tw.maxBattlesPerSession on first run; range 1-10.
ERP_D4TW_MAX_BATTLES_PER_SESSION=1
